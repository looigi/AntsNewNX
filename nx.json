{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/tsconfig.spec.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "cache": true
    },
    "test": {
      "cache": true
    }
  },
  "release": {
    "projectsRelationship": "independent",
    "projects": [
      "*"
    ],
    "releaseTagPattern": "{projectName}@{version}",
    "version": {
      "currentVersionResolver": "disk",
      "updateDependents": "never",
      "git": {
        "commit": true,
        "tag": true,
        "commitMessage": "chore(release): aggiornamento versioni"
      }
    },
    "changelog": {
      "projectChangelogs": false,
      "workspaceChangelog": false
    }
  }
}
