{
  "name": "ModuloAPK",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ModuloAPK/src",
  "projectType": "library",
  "tags": [
    "type:library"
  ],
  "targets": {
    "build": {
      "executor": "@nx/angular:package",
      "outputs": [
        "{workspaceRoot}/dist/libs/ModuloAPK"
      ],
      "options": {
        "project": "libs/ModuloAPK/ng-package.json",
        "tsConfig": "libs/ModuloAPK/tsconfig.lib.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/ModuloAPK/tsconfig.lib.prod.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "build-demo": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath.base}"
      ],
      "options": {
        "outputPath": {
          "base": "dist/demo/ModuloAPK",
          "browser": ""
        },
        "index": "libs/ModuloAPK/src/index.html",
        "browser": "libs/ModuloAPK/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "libs/ModuloAPK/tsconfig.app.json",
        "assets": [
          {
            "glob": "favicon.ico",
            "input": "libs/ModuloAPK/src",
            "output": "/"
          },
          {
            "glob": "**/*",
            "input": "libs/ModuloAPK/src/assets",
            "output": "assets"
          }
        ],
        "styles": [
          "libs/ModuloAPK/src/styles.css"
        ],
        "scripts": []
      },
      "configurations": {
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "production": {
          "optimization": true,
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "buildTarget": "ModuloAPK:build-demo:development"
      },
      "configurations": {
        "production": {
          "buildTarget": "ModuloAPK:build-demo:production"
        }
      }
    }
  }
}
