{
  "manifest_version": 2,
  "name": "Manage Tabs Extension!",
  "version": "1.0.0",
  "permissions": [ "tabs", "activeTab" ],
  "description": "Build an Extension!",
  "browser_action": {
    "default_popup": "index.html"
  },
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'"
}
