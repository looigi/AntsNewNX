{
  "name": "DataDictionaries",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/DataDictionaries/src",
  "projectType": "application",
  "prefix": "app",
  "tags": [
    "type:application"
  ],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": [
        "{options.outputPath.base}"
      ],
      "options": {
        "outputPath": {
          "base": "dist/apps/DataDictionaries",
          "browser": ""
        },
        "index": "apps/DataDictionaries/src/index.html",
        "browser": "apps/DataDictionaries/src/main.ts",
        "polyfills": [
          "zone.js"
        ],
        "tsConfig": "apps/DataDictionaries/tsconfig.app.json",
        "assets": [
          {
            "glob": "favicon.ico",
            "input": "apps/DataDictionaries/src",
            "output": "/"
          },
          {
            "glob": "**/*",
            "input": "apps/DataDictionaries/src/assets",
            "output": "assets"
          },
          {
            "glob": "web.config",
            "input": "tools/iis",
            "output": "/"
          }
        ],
        "styles": [
          "node_modules/primeicons/primeicons.css",
          "node_modules/bootstrap/dist/css/bootstrap.min.css",
          "node_modules/angular2-draggable/css/resizable.min.css",
          "node_modules/@progress/kendo-theme-default/dist/all.css",
          "apps/DataDictionaries/src/styles.css",
          "node_modules/@angular/material/prebuilt-themes/deeppurple-amber.css",
          "node_modules/sweetalert2/src/sweetalert2.scss"
        ],
        "scripts": []
      },
      "configurations": {
        "production": {
          "optimization": true,
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "DataDictionaries:build:production"
        },
        "development": {
          "buildTarget": "DataDictionaries:build:development"
        }
      },
      "defaultConfiguration": "development"
    }
  }
}
